# Environment Configuration for Fruit Fly Racer

# Remote Repository URL for Neural Memory Sync (optional)
# If set, the fly will fetch/upload learned weights from this URL
REMOTE_SYNC_URL=https://example.com/api/fly-memory

# Simulation Parameters
TUNNEL_LENGTH=100.0
TUNNEL_RADIUS=5.0
MAX_SPEED=5.0
WIND_BASE_SPEED=0.5
WIND_TURBULENCE=0.3

# Neural Network Parameters
INPUT_SIZE=100
HIDDEN_SIZE=200
OUTPUT_SIZE=20

# Training Parameters
NUM_SIMULATIONS=1000000
LEARNING_RATE=0.001
BATCH_SIZE=32

# Technical Notes:
# - Official flybody requires Bazel (Windows build issues)
# - Using custom MuJoCo fly model as alternative with full body anatomy
# - PyTorch has DLL issues on Windows, using NumPy (PyTorch-compatible architecture)
# - All core functionality implemented per specification